{
    "overrides": {
        "dotprompt": "1.1.1"
    },
    "name": "functions",
    "type": "module",
    "scripts": {
        "lint": "eslint --ext .js,.ts .",
        "build": "tsc",
        "build:watch": "tsc --watch --preserveWatchOutput",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@genkit-ai/firebase": "^1.41.0",
        "@genkit-ai/google-genai": "^1.41.0",
        "@google-cloud/storage": "^8.0.1",
        "@stoker-platform/node-client": "latest",
        "@stoker-platform/system-functions": "latest",
        "@stoker-platform/types": "latest",
        "algoliasearch": "^5.57.0",
        "dotenv": "^17.4.2",
        "firebase-admin": "^14.3.0",
        "firebase-functions": "^7.4.0",
        "genkit": "^1.41.0",
        "lodash": "^4.18.1",
        "lucide-react": "^1.33.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^8.57.1",
        "eslint-config-google": "^0.14.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-security": "^4.0.1",
        "typescript": "^6.0.3"
    },
    "private": true
}
