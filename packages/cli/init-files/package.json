{
    "overrides": {
        "sharp": "^0.35.0"
    },
    "name": "stoker",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "UNLICENSED",
    "scripts": {
        "clean:lib": "rm -rf lib",
        "clean:functions": "rm -rf functions/lib",
        "dev:assets": "npm run clean:lib && tsc && node bin/build.js && node bin/shim.js && npm --prefix functions run build && npx stoker update-emulator-schema && cp -r src/. web-app/src/assets/system-custom && cp lib/main.js web-app/src/assets/system-custom/main.js",
        "dev": "nodemon --quiet --watch src --ext ts,tsx,js,json --exec \"npm run dev:assets\"",
        "web:dev": "cd web-app && npm run dev",
        "prestart": "npm run build && npx stoker build-web-app && rm -rf web-app && mkdir web-app && cp -r node_modules/@stoker-platform/web-app/. web-app/ && stoker apply",
        "start": "concurrently \"bash -c 'npm run dev'\" \"npm run web:dev\" \"stoker start\"",
        "format": "prettier . --write",
        "lint": "tsc --noEmit && eslint . && npm --prefix functions run lint",
        "prebuild": "npm run clean:lib && npm run clean:functions",
        "build": "node bin/install.js && tsc && node bin/build.js && node bin/shim.js && npm --prefix functions run build",
        "test": "vitest --run",
        "admin-emulators": "export FIREBASE_AUTH_EMULATOR_HOST='127.0.0.1:9099' && export FIREBASE_DATABASE_EMULATOR_HOST='127.0.0.1:9000' && export FIRESTORE_EMULATOR_HOST='127.0.0.1:8080' && export FIREBASE_STORAGE_EMULATOR_HOST='127.0.0.1:9199'"
    },
    "dependencies": {
        "@stoker-platform/cli": "latest",
        "@stoker-platform/node-client": "latest",
        "@stoker-platform/types": "latest",
        "@stoker-platform/utils": "latest",
        "@stoker-platform/web-app": "latest",
        "@stoker-platform/web-client": "latest",
        "firebase-admin": "^14.3.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitest/browser": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.5",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-security": "^4.0.1",
        "postcss": "^8.5.26",
        "prettier": "3.9.6",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    }
}
