        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@genkit-ai/firebase": "^1.41.0",
        "@genkit-ai/vertexai": "^1.41.0",
        "@google-cloud/storage": "^8.0.1",
        "@stoker-platform/types": "file:./local-packages/stoker-platform-types-0.5.68.tgz",
        "@stoker-platform/node-client": "file:./local-packages/stoker-platform-node-client-0.5.98.tgz",
        "@stoker-platform/system-functions": "file:./local-packages/stoker-platform-system-functions-0.5.119.tgz",
        "@stoker-platform/utils": "file:./local-packages/stoker-platform-utils-0.5.85.tgz",
        "@types/luxon": "^3.7.4",
        "algoliasearch": "^5.57.0",
        "dotenv": "^17.4.2",
        "firebase-admin": "^14.3.0",
        "firebase-functions": "^7.3.2",
        "genkit": "^1.41.0",
        "lodash": "^4.18.1",
        "lucide-react": "^1.33.0",
        "luxon": "^3.7.2",
        "xero-node": "latest"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^8.57.1",
