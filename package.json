{
    "overrides": {
        "dotprompt": "1.1.1",
        "@types/react": "18.3.13",
        "@types/react-dom": "18.3.1",
        "sharp": "^0.35.0"
    },
    "name": "stoker",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "UNLICENSED",
    "workspaces": [
        "apps/starter",
        "apps/web",
        "apps/docs",
        "packages/cli",
        "packages/node-client",
        "packages/web-client",
        "packages/web-test",
        "packages/utils",
        "packages/system-functions",
        "packages/types",
        "packages/tsconfig",
        "packages/eslint-config-custom"
    ],
    "scripts": {
        "dev": "turbo run dev --concurrency 12",
        "format": "prettier . --write",
        "lint": "turbo run format && turbo run lint",
        "build": "turbo run build --filter=!./apps/starter",
        "publish-packages": "turbo run format && turbo run lint && turbo run build --filter=!./apps/starter && changeset version && changeset publish"
    },
    "dependencies": {
        "@changesets/cli": "^3.0.1"
    },
    "devDependencies": {
        "@vitejs/devtools": "^0.7.1",
        "@vitejs/devtools-rolldown": "^0.7.5",
        "@vitejs/devtools-vite": "^0.7.5",
        "@vitejs/devtools-vitest": "^0.7.5",
        "@vitest/browser": "^5.0.2",
        "@vitest/browser-playwright": "^5.0.2",
        "@vitest/ui": "^5.0.2",
        "concurrently": "^10.0.5",
        "dotenv": "^17.4.2",
        "eslint": "^8.57.1",
        "prettier": "3.9.6",
        "turbo": "^2.10.11",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "packageManager": "npm@12.0.2",
    "description": "Build realtime, offline-ready enterprise applications.",
    "homepage": "https://stoker-platform.web.app",
    "repository": {
        "repository": {
            "type": "git",
            "url": "git+https://github.com/outpost-software/stoker.git"
        }
    },
    "bugs": "https://github.com/outpost-software/stoker/issues",
    "keywords": [
        "internal tools",
        "headless CMS",
        "application framework",
        "firestore"
    ]
}
